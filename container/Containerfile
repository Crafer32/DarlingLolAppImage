# Entorno de build portable de darling-lol: Ubuntu 24.04 (glibc 2.39) + LLVM 23
FROM docker.io/library/ubuntu:24.04
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl gnupg wget git git-lfs python3 python3-venv python3-pip \
    cmake make ninja-build bison flex pkg-config file patchelf xz-utils zstd unzip \
    libfuse-dev libudev-dev libcap2-bin libcap-dev libglu1-mesa-dev libcairo2-dev libgl1-mesa-dev \
    libtiff5-dev libfreetype-dev libxml2-dev libegl1-mesa-dev libfontconfig-dev libbsd-dev \
    libxrandr-dev libxcursor-dev libgif-dev libavutil-dev libpulse-dev libavformat-dev \
    libavcodec-dev libswresample-dev libdbus-1-dev libxkbfile-dev libssl-dev libvulkan-dev \
    libcurl4-openssl-dev libedit-dev libx11-dev libxext-dev libxcb1-dev \
    libxcb-shm0-dev libx11-xcb-dev libxfixes-dev libxi-dev libxrender-dev libwayland-dev \
    glslang-tools spirv-tools gcc g++ sudo squashfs-tools desktop-file-utils nasm \
 && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL https://apt.llvm.org/llvm-snapshot.gpg.key | gpg --dearmor -o /usr/share/keyrings/llvm.gpg \
 && echo "deb [signed-by=/usr/share/keyrings/llvm.gpg] http://apt.llvm.org/noble/ llvm-toolchain-noble-23 main" > /etc/apt/sources.list.d/llvm.list \
 && apt-get update && apt-get install -y --no-install-recommends clang-23 lld-23 llvm-23-dev libclang-23-dev \
 && rm -rf /var/lib/apt/lists/*
RUN ln -sfn x86_64-linux-gnu/asm /usr/include/asm
ENV PATH=/usr/lib/llvm-23/bin:$PATH

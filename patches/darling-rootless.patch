+// darling-lol rootless: started by a non-setuid `darling` inside an unprivileged user
+// namespace, with the namespace capabilities passed as ambient caps. We already run as the
+// user, so the uid/gid juggling below becomes a no-op and "dropping" means dropping caps.
+static bool rootless = false;
+
+static void drop_all_caps() {
+	struct __user_cap_header_struct hdr = { _LINUX_CAPABILITY_VERSION_3, 0 };
+	struct __user_cap_data_struct data[2] = {};
+
+	prctl(PR_CAP_AMBIENT, PR_CAP_AMBIENT_CLEAR_ALL, 0, 0, 0);
+	if (syscall(SYS_capset, &hdr, data) != 0) {
+		fprintf(stderr, "Failed to drop capabilities: %s\n", strerror(errno));
+		exit(1);
+	}
+};

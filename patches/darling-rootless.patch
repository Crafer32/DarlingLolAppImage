+// ---- darling-lol rootless helpers ----------------------------------------------------
+
+static void detectInstallPrefix(void)
+{
+	const char* env = getenv("DARLING_INSTALL_PREFIX");
+	char exe[PATH_MAX], probe[PATH_MAX + 32];
+	struct stat st;
+
+	// Only a non-setuid binary may relocate itself: a setuid one must not trust the
+	// environment or its own location (it would run a user-chosen darlingserver as root).
+	if (!g_rootless)
+		return;
+
+	if (env && env[0] == '/' && strlen(env) < sizeof(g_installPrefix))
+	{
+		strcpy(g_installPrefix, env);
+		return;
+	}
+
+	ssize_t len = readlink("/proc/self/exe", exe, sizeof(exe) - 1);
+	if (len <= 0)
+		return;
+	exe[len] = '\0';
+
+	// <prefix>/bin/darling -> <prefix>
+	char* slash = strrchr(exe, '/');
+	if (!slash) return;
+	*slash = '\0';
+	slash = strrchr(exe, '/');
+	if (!slash || strcmp(slash, "/bin") != 0) return;
+	*slash = '\0';
+
+	snprintf(probe, sizeof(probe), "%s/bin/darlingserver", exe);
+	if (stat(probe, &st) == 0 && strlen(exe) < sizeof(g_installPrefix))
+		strcpy(g_installPrefix, exe);
+}
+
+static int writeProcFile(const char* path, const char* text)
+{
+	int fd = open(path, O_WRONLY | O_CLOEXEC);
+	if (fd < 0)
+		return -1;
+	ssize_t n = write(fd, text, strlen(text));
+	int saved = errno;
+	close(fd);
+	errno = saved;
+	return n == (ssize_t) strlen(text) ? 0 : -1;
+}
+
+static void setupUserNamespace(void)
+{
+	char map[64];
+
+	if (unshare(CLONE_NEWUSER) != 0)
+	{
+		fprintf(stderr, "Darling (rootless) cannot create a user namespace: %s\n", strerror(errno));
+		fprintf(stderr, "Unprivileged user namespaces are disabled on this system. Either:\n"
+			"  - enable them (e.g. sysctl kernel.unprivileged_userns_clone=1, or on Ubuntu 24.04+\n"
+			"    install the AppArmor profile from the darling-lol docs), or\n"
+			"  - make `darling` setuid root (classic Darling install).\n");
+		exit(1);
+	}
+
+	// Map our own uid/gid to themselves: files keep their real owner, nothing else is mapped.
+	if (writeProcFile("/proc/self/setgroups", "deny") != 0 && errno != ENOENT)
+	{
+		fprintf(stderr, "Cannot write /proc/self/setgroups: %s\n", strerror(errno));
+		exit(1);
+	}
+	snprintf(map, sizeof(map), "%u %u 1\n", (unsigned) g_originalUid, (unsigned) g_originalUid);
+	if (writeProcFile("/proc/self/uid_map", map) != 0)
+	{
+		fprintf(stderr, "Cannot write uid_map: %s\n", strerror(errno));
+		exit(1);
+	}
+	snprintf(map, sizeof(map), "%u %u 1\n", (unsigned) g_originalGid, (unsigned) g_originalGid);
+	if (writeProcFile("/proc/self/gid_map", map) != 0)
+	{
+		fprintf(stderr, "Cannot write gid_map: %s\n", strerror(errno));
+		exit(1);
+	}
+}
+
+static void joinServerUserNamespace(pid_t pidInit)
+{
+	char ours[64] = "", theirs[64] = "", path[64];
+
+	readlink("/proc/self/ns/user", ours, sizeof(ours) - 1);
+	snprintf(path, sizeof(path), "/proc/%d/ns/user", pidInit);
+	if (readlink(path, theirs, sizeof(theirs) - 1) <= 0)
+		return;
+	if (strcmp(ours, theirs) != 0)
+		joinNamespace(pidInit, CLONE_NEWUSER, "user");
+}
+
+static void raiseAmbientCaps(void)
+{
+	static const int caps[] = {
+		CAP_SYS_ADMIN, CAP_SETUID, CAP_SETGID, CAP_CHOWN, CAP_FOWNER,
+		CAP_DAC_OVERRIDE, CAP_DAC_READ_SEARCH, CAP_KILL, CAP_SYS_RESOURCE,
+	};
+	struct __user_cap_header_struct hdr = { _LINUX_CAPABILITY_VERSION_3, 0 };
+	struct __user_cap_data_struct data[2];
+
+	if (syscall(SYS_capget, &hdr, data) != 0)
+	{
+		fprintf(stderr, "capget failed: %s\n", strerror(errno));
+		exit(1);
+	}
+	data[0].inheritable = data[0].permitted;
+	data[1].inheritable = data[1].permitted;
+	if (syscall(SYS_capset, &hdr, data) != 0)
+	{
+		fprintf(stderr, "capset failed: %s\n", strerror(errno));
+		exit(1);
+	}
+	for (size_t i = 0; i < sizeof(caps) / sizeof(caps[0]); i++)
+	{
+		if (prctl(PR_CAP_AMBIENT, PR_CAP_AMBIENT_RAISE, caps[i], 0, 0) != 0)
+		{
+			fprintf(stderr, "Cannot raise ambient capability %d: %s\n", caps[i], strerror(errno));
+			exit(1);
+		}
+	}
+}

diff --git a/tools/check-riot-ifmedia.py b/tools/check-riot-ifmedia.py
new file mode 100644
index 0000000..c358e5c
--- /dev/null
+++ b/tools/check-riot-ifmedia.py
@@ -0,0 +1,72 @@
+#!/usr/bin/env python3
+"""Build and run the standalone SIOCGIFMEDIA probe inside Darling.
+
+No Riot or League process is started. The probe only enumerates local
+interfaces and issues SIOCGIFMEDIA, which is the call Vivox uses before
+vx_req_connector_create.
+"""
+import argparse
+import json
+import os
+from pathlib import Path
+import shutil
+import subprocess
+import sys
+
+ROOT = Path(__file__).resolve().parents[1]
+CONFIG = ROOT / 'build/config.json'
+SOURCE = ROOT / 'tools/riot-ifmedia-check.c'
+OUTPUT = ROOT / 'build/riot-ifmedia-check'
+
+
+def find_sdk():
+    candidates = [
+        ROOT / 'build/darling-src/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk',
+        ROOT / 'build/darling-src/build/Developer/Platforms/MacOSX.platform/Developer/SDKs/MacOSX.sdk',
+    ]
+    for candidate in candidates:
+        if (candidate / 'usr/include/sys/socket.h').is_file():
+            return candidate
+    raise SystemExit('MacOSX.sdk not found; run ./scripts/build.sh first')
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('--guest-home', default=None,
+                        help='guest home, e.g. /Users/hirew (default: build/config.json)')
+    parser.add_argument('--library-path', default=None,
+                        help='extra guest DYLD_LIBRARY_PATH entry, e.g. a rebuilt kernel overlay')
+    parser.add_argument('--timeout', type=float, default=60)
+    args = parser.parse_args()
+
+    config = json.loads(CONFIG.read_text()) if CONFIG.exists() else {}
+    guest_home = args.guest_home or config.get('guest_home')
+    if not guest_home:
+        guest_home = '/Users/' + os.environ.get('USER', '')
+    sdk = find_sdk()
+
+    clang = shutil.which('clang')
+    if not clang:
+        raise SystemExit('clang not found')
+    OUTPUT.parent.mkdir(exist_ok=True)
+    subprocess.run([
+        clang, '-target', 'x86_64-apple-macosx11.0', '-D__DARWIN_UNIX03=0',
+        '-fuse-ld=lld', '-nostdlib', '-isysroot', str(sdk),
+        str(SOURCE), '-lSystem', '-o', str(OUTPUT),
+    ], check=True)
+
+    libraries = guest_home.rstrip('/') + '/RuntimeLibraries'
+    if args.library_path:
+        libraries = args.library_path.rstrip('/') + ':' + libraries
+    guest_probe = '/Volumes/SystemRoot' + str(OUTPUT)
+    env = {key: os.environ[key] for key in ('PATH', 'HOME', 'USER', 'LOGNAME', 'DISPLAY',
+           'XAUTHORITY', 'XDG_RUNTIME_DIR', 'DBUS_SESSION_BUS_ADDRESS', 'LANG') if key in os.environ}
+    result = subprocess.run([
+        'darling', 'shell', 'env', 'DYLD_LIBRARY_PATH=' + libraries,
+        guest_probe,
+    ], env=env, timeout=args.timeout)
+    return result.returncode
+
+
+if __name__ == '__main__':
+    sys.exit(main())
diff --git a/tools/riot-ifmedia-check.c b/tools/riot-ifmedia-check.c
new file mode 100644
index 0000000..7e3167e
--- /dev/null
+++ b/tools/riot-ifmedia-check.c
@@ -0,0 +1,58 @@
+// Vivox's network reachability provider calls SIOCGIFMEDIA on each interface
+// and drops every interface whose ioctl fails. Darling used to pass the Darwin
+// request through to Linux, which returns ENOTTY.
+#include <ifaddrs.h>
+#include <net/if.h>
+#include <net/if_media.h>
+#include <sys/ioctl.h>
+#include <sys/socket.h>
+#include <sys/sockio.h>
+#include <errno.h>
+#include <stdio.h>
+#include <string.h>
+#include <unistd.h>
+
+static int check(const char *name, int required) {
+    int sock = socket(AF_INET, SOCK_DGRAM, 0);
+    struct ifmediareq ifmr;
+    memset(&ifmr, 0, sizeof(ifmr));
+    strncpy(ifmr.ifm_name, name, sizeof(ifmr.ifm_name) - 1);
+    errno = 0;
+    int rc = ioctl(sock, SIOCGIFMEDIA, &ifmr);
+    close(sock);
+    int active = (ifmr.ifm_status & (IFM_AVALID | IFM_ACTIVE)) == (IFM_AVALID | IFM_ACTIVE);
+    int known_type = IFM_TYPE(ifmr.ifm_current) == IFM_ETHER ||
+                     IFM_TYPE(ifmr.ifm_current) == IFM_IEEE80211;
+    printf("IFMEDIA interface=%s rc=%d errno=%d current=0x%x status=0x%x active=%d type=%d\n",
+           name, rc, errno, ifmr.ifm_current, ifmr.ifm_status, active, known_type);
+    if (rc != 0) return required;
+    return required && (!active || !known_type);
+}
+
+int main(int argc, char **argv) {
+    int failures = 0;
+    if (argc > 1) {
+        for (int i = 1; i < argc; i++) failures += check(argv[i], 1);
+    } else {
+        struct ifaddrs *interfaces = NULL;
+        char name[IFNAMSIZ] = {0};
+        if (getifaddrs(&interfaces) != 0) {
+            printf("IFMEDIA getifaddrs failed errno=%d\n", errno);
+            return 1;
+        }
+        for (struct ifaddrs *entry = interfaces; entry; entry = entry->ifa_next) {
+            if (!entry->ifa_addr || entry->ifa_addr->sa_family != AF_INET) continue;
+            if (entry->ifa_flags & IFF_LOOPBACK) continue;
+            strncpy(name, entry->ifa_name, sizeof(name) - 1);
+            break;
+        }
+        freeifaddrs(interfaces);
+        if (!name[0]) {
+            printf("IFMEDIA no non-loopback IPv4 interface\n");
+            return 1;
+        }
+        failures += check(name, 1);
+    }
+    printf("IFMEDIA_CHECK failures=%d\n", failures);
+    return failures ? 1 : 0;
+}

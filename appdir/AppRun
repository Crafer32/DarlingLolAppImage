#!/bin/sh
# DarlingLolAppImage: League of Legends (macOS client) on Darling, rootless.
#
#   ./darling-lol.AppImage               launch (the first run sets everything up)
#   ./darling-lol.AppImage --installer   (re)install the Riot Client (RCLOL_REGION, default EUW)
#   ./darling-lol.AppImage --shell       open a shell inside Darling
#   ./darling-lol.AppImage --shutdown    stop Darling
#
# Everything lives in one folder, ~/.darling-lol (DARLING_LOL_HOME): delete it and it's gone.
#   runtime/<version>   Darling + darling-lol runtime, unpacked from this AppImage
#   project/            launcher scripts rendered for this user
#   prefix/             the "Mac": Riot Client and the game
#   cache/              Mesa shader cache
set -eu
APPDIR=${APPDIR:-$(dirname "$(readlink -f "$0")")}
VERSION=$(cat "$APPDIR/usr/share/darling-lol/VERSION")
BASE=${DARLING_LOL_HOME:-$HOME/.darling-lol}
RT=$BASE/runtime/$VERSION
export DPREFIX=${DPREFIX:-$BASE/prefix}
export RCLOL_REGION=${RCLOL_REGION:-EUW}
export MESA_SHADER_CACHE_DIR=${MESA_SHADER_CACHE_DIR:-$BASE/cache}

say() { printf 'darling-lol: %s\n' "$*" >&2; }
die() {
	say "$*"
	command -v notify-send >/dev/null 2>&1 && notify-send -i dialog-error "darling-lol" "$*" 2>/dev/null || true
	exit 1
}
vge() { [ "$(printf '%s\n%s\n' "$2" "$1" | sort -V | head -1)" = "$2" ]; }

# ---- 1. Basic checks (clear errors instead of strange failures later) -----------------
k=$(uname -r | sed 's/[^0-9.].*//')
vge "$k" 5.15 || die "Linux $k is too old: needs Linux 5.15 or newer."
g=$(getconf GNU_LIBC_VERSION 2>/dev/null | awk '{print $2}')
vge "${g:-0}" 2.39 || die "glibc ${g:-not found}: needs glibc 2.39 or newer."
command -v python3 >/dev/null 2>&1 || die "python3 is missing. Install it with your package manager and try again."
[ -n "${DISPLAY:-}" ] || die "No X11 display. Use an X11 session or Wayland with XWayland."

# ---- 2. Older layout (r1-r3: runtime in ~/.local/share, prefix in ~/.darling-lol) -------
if [ -z "${DARLING_LOL_HOME:-}" ] && [ -d "$BASE/Applications" ] && [ ! -d "$BASE/prefix" ]; then
	pgrep -f "darlingserver $BASE" >/dev/null 2>&1 && die "Darling is still running: close the game and the clients first."
	say "Moving everything into $BASE (one folder)..."
	mv "$BASE" "$BASE.old-layout"
	mkdir -p "$BASE"
	mv "$BASE.old-layout" "$BASE/prefix"
	[ -d "$BASE.workdir" ] && mv "$BASE.workdir" "$BASE/prefix.workdir"
	rm -rf "${XDG_DATA_HOME:-$HOME/.local/share}/darling-lol"
fi

# ---- 3. Runtime (once per version) ------------------------------------------------------
# Darling keeps running after this AppImage exits, so it can't live in the FUSE mount.
if [ ! -f "$RT/.complete" ]; then
	say "First run of $VERSION: unpacking the runtime (about 1 GB, one time)..."
	rm -rf "$RT.partial"
	mkdir -p "$RT.partial"
	cp -a "$APPDIR/usr/." "$RT.partial/"
	touch "$RT.partial/.complete"
	rm -rf "$RT"
	mv "$RT.partial" "$RT"
	for old in "$BASE"/runtime/*; do [ "$old" = "$RT" ] || rm -rf "$old"; done
fi

export PATH="$RT/bin:$PATH"
# run.sh puts /usr/local/bin first; this keeps our darling ahead of any system install
export DARLING_RUNNER_DIR="$RT/bin"
export DARLING_XSHM_HOST_LIBRARY="$RT/lib/darling-lol/libdarling-xshm.so"
# Type 1 (X11 core) fonts crash the CEF renderer ("Preparing browse"): hide them.
export FONTCONFIG_FILE="$RT/share/darling-lol/fonts.conf"
PROJECT=$BASE/project
GUEST_USER=$(id -un)
case "$GUEST_USER" in *[!A-Za-z0-9_-]*) die "User name '$GUEST_USER' must only use letters, digits, _ or -." ;; esac
GUEST_HOME=$DPREFIX/Users/$GUEST_USER

# ---- 3. Project scripts rendered for this user ---------------------------------------
if [ ! -f "$PROJECT/.version" ] || [ "$(cat "$PROJECT/.version")" != "$VERSION" ]; then
	rm -rf "$PROJECT"
	mkdir -p "$PROJECT"
	cp -a "$RT/share/darling-lol/project/." "$PROJECT/"
	echo "$VERSION" > "$PROJECT/.version"
fi
cd "$PROJECT"
python3 scripts/configure.py --guest-user "$GUEST_USER" --prefix "$DPREFIX" --sdk "$RT/libexec/darling" >/dev/null

# ---- 4. Prefix and per-user overlays --------------------------------------------------
if [ ! -f "$GUEST_HOME/.darling-lol-runtime" ] || [ "$(cat "$GUEST_HOME/.darling-lol-runtime")" != "$VERSION" ]; then
	new_prefix=
	[ -e "$DPREFIX" ] || new_prefix=1
	say "Preparing the macOS prefix $DPREFIX ..."
	darling shell /usr/bin/true
	mkdir -p "$DPREFIX/private/tmp"
	chmod 1777 "$DPREFIX/private/tmp"
	darling shutdown 2>/dev/null || true
	mkdir -p "$GUEST_HOME"
	tar -C "$GUEST_HOME" -xzf "$RT/share/darling-lol/guest-runtime.tar.gz"
	mkdir -p "$DPREFIX/usr/sbin"
	install -m755 "$RT/share/darling-lol/system_profiler" "$DPREFIX/usr/sbin/system_profiler"
	if [ -n "$new_prefix" ]; then
		python3 tools/configure-darling-platform.py --prefix "$DPREFIX" --provision --write >/dev/null ||
			say "Could not give the prefix its own platform identity (non-fatal)."
	fi
	echo "$VERSION" > "$GUEST_HOME/.darling-lol-runtime"
fi

# ---- 5. Riot ----------------------------------------------------------------------------
case "${1:-}" in
	--shell) shift; exec darling shell "$@" ;;
	--shutdown) exec darling shutdown ;;
	--installer) exec sh scripts/installer.sh "$(echo "$RCLOL_REGION" | tr '[:upper:]' '[:lower:]')" ;;
esac
if [ ! -d "$DPREFIX/Users/Shared/Riot Games/Riot Client.app" ] && [ ! -e "$DPREFIX/Applications/Riot Client.app" ]; then
	say "Riot Client is not installed yet: starting the installer (region $RCLOL_REGION)."
	exec sh scripts/installer.sh "$(echo "$RCLOL_REGION" | tr '[:upper:]' '[:lower:]')"
fi
exec sh scripts/run.sh

#!/bin/sh
# DarlingLolAppImage: League of Legends (macOS client) on Darling, rootless.
#
#   ./darling-lol.AppImage               launch (the first run sets everything up)
#   ./darling-lol.AppImage --installer   (re)install the Riot Client (RCLOL_REGION, default EUW)
#   ./darling-lol.AppImage --shell       open a shell inside Darling
#   ./darling-lol.AppImage --shutdown    stop Darling
#
# Everything lives in one folder, ~/.darling-lol (DARLING_LOL_HOME): delete it and it's gone.
#   runtime/<version>   Darling + darling-lol runtime, unpacked from this AppImage
#   project/            launcher scripts rendered for this user
#   prefix/             the "Mac": Riot Client and the game
#   cache/              Mesa shader cache
set -eu
# The AppImage runtime hands us an open descriptor on its FUSE mount (fd 1023). darlingserver
# keeps running after we exit and would inherit it, so the AppImage never unmounts and the
# launcher seems to hang. dash can't close fds above 9, so re-exec once with them closed.
if [ -z "${DARLING_LOL_FDS_CLOSED:-}" ] && command -v python3 >/dev/null 2>&1; then
	export DARLING_LOL_FDS_CLOSED=1
	exec python3 -c '
import os, sys
mnt = os.environ.get("APPDIR") or os.path.dirname(os.path.realpath(sys.argv[1]))
for fd in os.listdir("/proc/self/fd"):
    try:
        if int(fd) > 2 and os.readlink("/proc/self/fd/" + fd).startswith(mnt):
            os.close(int(fd))  # only the mount descriptor; the pipe to the runtime must stay
    except OSError:
        pass
os.execv("/bin/sh", ["/bin/sh"] + sys.argv[1:])' "$0" "$@"
fi
APPDIR=${APPDIR:-$(dirname "$(readlink -f "$0")")}
VERSION=$(cat "$APPDIR/usr/share/darling-lol/VERSION")
# unique per build (older AppImages only have VERSION)
BUILD=$(cat "$APPDIR/usr/share/darling-lol/BUILD" 2>/dev/null || echo "$VERSION")
BASE=${DARLING_LOL_HOME:-$HOME/.darling-lol}
RT=$BASE/runtime/$BUILD
export DPREFIX=${DPREFIX:-$BASE/prefix}
export RCLOL_REGION=${RCLOL_REGION:-EUW}
export MESA_SHADER_CACHE_DIR=${MESA_SHADER_CACHE_DIR:-$BASE/cache}
# Close the League client UI while a match runs (darling-lol helper): otherwise the client that
# comes back after the match is a second CEF instance whose window stays black. Set to 0 to keep
# the in-client chat during matches.
export RCLOL_CLOSE_CLIENT_IN_GAME=${RCLOL_CLOSE_CLIENT_IN_GAME:-1}

say() { printf 'darling-lol: %s\n' "$*" >&2; }
# Desktop notification that replaces the previous one, so long steps don't look frozen
NOTIFY_ID=
note() {
	say "$*"
	command -v notify-send >/dev/null 2>&1 || return 0
	if [ -n "$NOTIFY_ID" ]; then
		notify-send -a "League of Legends" -i darling-lol -r "$NOTIFY_ID" "League of Legends" "$*" 2>/dev/null || true
	else
		NOTIFY_ID=$(notify-send -a "League of Legends" -i darling-lol -p "League of Legends" "$*" 2>/dev/null) || NOTIFY_ID=
	fi
}
die() {
	say "$*"
	command -v notify-send >/dev/null 2>&1 && notify-send -i dialog-error "darling-lol" "$*" 2>/dev/null || true
	exit 1
}
vge() { [ "$(printf '%s\n%s\n' "$2" "$1" | sort -V | head -1)" = "$2" ]; }

# ---- 1. Basic checks (clear errors instead of strange failures later) -----------------
k=$(uname -r | sed 's/[^0-9.].*//')
vge "$k" 5.15 || die "Linux $k is too old: needs Linux 5.15 or newer."
g=$(getconf GNU_LIBC_VERSION 2>/dev/null | awk '{print $2}')
vge "${g:-0}" 2.39 || die "glibc ${g:-not found}: needs glibc 2.39 or newer."
command -v python3 >/dev/null 2>&1 || die "python3 is missing. Install it with your package manager and try again."
[ -n "${DISPLAY:-}" ] || die "No X11 display. Use an X11 session or Wayland with XWayland."
# darlingserver's socket is $DPREFIX/.darlingserver.sock and a Unix socket path holds 107 bytes;
# a longer one fails later with an obscure "socket path is too long" and a hung launch
[ "$(printf %s "$DPREFIX/.darlingserver.sock" | wc -c)" -le 107 ] ||
	die "The prefix path is too long for Darling's socket: $DPREFIX. Set DARLING_LOL_HOME or DPREFIX to a shorter folder."

# ---- 2. Older layout (r1-r3: runtime in ~/.local/share, prefix in ~/.darling-lol) -------
if [ -z "${DARLING_LOL_HOME:-}" ] && [ -d "$BASE/Applications" ] && [ ! -d "$BASE/prefix" ]; then
	pgrep -f "darlingserver $BASE" >/dev/null 2>&1 && die "Darling is still running: close the game and the clients first."
	note "Moving everything into $BASE (one folder)..."
	mv "$BASE" "$BASE.old-layout"
	mkdir -p "$BASE"
	mv "$BASE.old-layout" "$BASE/prefix"
	[ -d "$BASE.workdir" ] && mv "$BASE.workdir" "$BASE/prefix.workdir"
	rm -rf "${XDG_DATA_HOME:-$HOME/.local/share}/darling-lol"
fi

# ---- 3. Runtime (once per version) ------------------------------------------------------
# Darling keeps running after this AppImage exits, so it can't live in the FUSE mount.
if [ ! -f "$RT/.complete" ]; then
	note "First run of $VERSION: unpacking the runtime (one time, about a minute)..."
	rm -rf "$RT.partial"
	mkdir -p "$RT.partial"
	cp -a "$APPDIR/usr/." "$RT.partial/"
	touch "$RT.partial/.complete"
	rm -rf "$RT"
	mv "$RT.partial" "$RT"
	for old in "$BASE"/runtime/*; do [ "$old" = "$RT" ] || rm -rf "$old"; done
fi

# ---- Menu entry: a launcher in the applications menu pointing at this AppImage, refreshed when
# the file is moved or renamed. DARLING_LOL_NO_DESKTOP=1 skips it.
if [ -n "${APPIMAGE:-}" ] && [ -z "${DARLING_LOL_NO_DESKTOP:-}" ]; then
	apps=${XDG_DATA_HOME:-$HOME/.local/share}/applications
	icons=${XDG_DATA_HOME:-$HOME/.local/share}/icons/hicolor/256x256/apps
	entry=$apps/darling-lol.desktop
	if ! grep -qF "Exec=\"$APPIMAGE\"" "$entry" 2>/dev/null; then
		mkdir -p "$apps" "$icons"
		cp -f "$APPDIR/darling-lol.png" "$icons/darling-lol.png" 2>/dev/null || true
		cat > "$entry" <<DESKTOP
[Desktop Entry]
Type=Application
Name=League of Legends (darling-lol)
Comment=League of Legends for macOS on Darling, rootless
Exec="$APPIMAGE"
Icon=darling-lol
Terminal=false
Categories=Game;
Actions=Shutdown;

[Desktop Action Shutdown]
Name=Stop Darling
Exec="$APPIMAGE" --shutdown
DESKTOP
		command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database "$apps" >/dev/null 2>&1 || true
	fi
fi

# `darling` wrapper: darlingserver outlives this launcher, and every descriptor it inherits from
# the AppImage runtime (the mount, the runtime's pipe) keeps the AppImage mounted forever. Start
# darling with only stdin/stdout/stderr.
mkdir -p "$BASE/bin"
cat > "$BASE/bin/darling" <<EOF
#!/bin/sh
exec python3 -c 'import os, sys; os.closerange(3, 65536); os.execv(sys.argv[1], sys.argv[1:])' "$RT/bin/darling" "\$@"
EOF
chmod +x "$BASE/bin/darling"
export PATH="$BASE/bin:$RT/bin:$PATH"
# run.sh puts /usr/local/bin first; this keeps our darling ahead of any system install
export DARLING_RUNNER_DIR="$BASE/bin"
export DARLING_XSHM_HOST_LIBRARY="$RT/lib/darling-lol/libdarling-xshm.so"
# Type 1 (X11 core) fonts crash the CEF renderer ("Preparing browse"): hide them.
export FONTCONFIG_FILE="$RT/share/darling-lol/fonts.conf"
export DARLING_LOL_MLDR="$RT/libexec/darling/usr/libexec/darling/mldr" DARLING_LOL_DARLING="$BASE/bin/darling"
# a Darling left running by an earlier session (no Riot/League window open) breaks the new launch
case "${1:-}" in --shutdown|--shell) ;; *) python3 "$RT/share/darling-lol/watch.py" stale ;; esac
PROJECT=$BASE/project
GUEST_USER=$(id -un)
case "$GUEST_USER" in *[!A-Za-z0-9_-]*) die "User name '$GUEST_USER' must only use letters, digits, _ or -." ;; esac
GUEST_HOME=$DPREFIX/Users/$GUEST_USER

# ---- 3. Project scripts rendered for this user ---------------------------------------
if [ ! -f "$PROJECT/.version" ] || [ "$(cat "$PROJECT/.version")" != "$BUILD" ]; then
	rm -rf "$PROJECT"
	mkdir -p "$PROJECT"
	cp -a "$RT/share/darling-lol/project/." "$PROJECT/"
	echo "$BUILD" > "$PROJECT/.version"
fi
cd "$PROJECT"
# Render the launcher scripts only when something they depend on changed
STAMP="$BUILD|$GUEST_USER|$DPREFIX|$RT"
if [ ! -f .configured ] || [ "$(cat .configured)" != "$STAMP" ]; then
	python3 scripts/configure.py --guest-user "$GUEST_USER" --prefix "$DPREFIX" --sdk "$RT/libexec/darling" >/dev/null
	echo "$STAMP" > .configured
fi

# ---- 4. Prefix and per-user overlays --------------------------------------------------
if [ ! -f "$GUEST_HOME/.darling-lol-runtime" ] || [ "$(cat "$GUEST_HOME/.darling-lol-runtime")" != "$BUILD" ]; then
	new_prefix=
	[ -e "$DPREFIX" ] || new_prefix=1
	note "Preparing the macOS prefix (first time only)..."
	darling shell /usr/bin/true
	mkdir -p "$DPREFIX/private/tmp"
	chmod 1777 "$DPREFIX/private/tmp"
	darling shutdown 2>/dev/null || true
	mkdir -p "$GUEST_HOME"
	tar -C "$GUEST_HOME" -xzf "$RT/share/darling-lol/guest-runtime.tar.gz"
	mkdir -p "$DPREFIX/usr/sbin"
	install -m755 "$RT/share/darling-lol/system_profiler" "$DPREFIX/usr/sbin/system_profiler"
	if [ -n "$new_prefix" ]; then
		python3 tools/configure-darling-platform.py --prefix "$DPREFIX" --provision --write >/dev/null ||
			say "Could not give the prefix its own platform identity (non-fatal)."
	fi
	echo "$BUILD" > "$GUEST_HOME/.darling-lol-runtime"
fi

# ---- 5. Riot ----------------------------------------------------------------------------
case "${1:-}" in
	--shell) shift; exec darling shell "$@" ;;
	--shutdown) exec darling shutdown ;;
	--installer) exec sh scripts/installer.sh "$(echo "$RCLOL_REGION" | tr '[:upper:]' '[:lower:]')" ;;
esac
if [ ! -d "$DPREFIX/Users/Shared/Riot Games/Riot Client.app" ] && [ ! -e "$DPREFIX/Applications/Riot Client.app" ]; then
	say "Riot Client is not installed yet: starting the installer (region $RCLOL_REGION)."
	exec sh scripts/installer.sh "$(echo "$RCLOL_REGION" | tr '[:upper:]' '[:lower:]')"
fi
# Darling outlives the windows (the Riot Client leaves background agents running), so a small
# watcher stops it once the Riot Client and League have been closed for a while.
# RCLOL_AUTO_SHUTDOWN=0 turns it off; RCLOL_AUTO_SHUTDOWN_DELAY sets the wait in seconds.
start_watcher() {
	pidfile=$BASE/watch.pid
	if [ -f "$pidfile" ] && kill -0 "$(cat "$pidfile")" 2>/dev/null; then return; fi
	setsid python3 -c 'import os, sys; os.closerange(3, 65536); os.execv(sys.executable, [sys.executable] + sys.argv[1:])' \
		"$RT/share/darling-lol/watch.py" </dev/null >>"$BASE/watch.log" 2>&1 &
	echo $! > "$pidfile"
}
start_watcher
# Press Play for the user once the Riot Client is signed in, and keep the Riot Client off the
# taskbar while League runs (RCLOL_AUTOPLAY=0 / RCLOL_HIDE_RIOT_CLIENT=0 turn these off).
if ! { [ -f "$BASE/autoplay.pid" ] && kill -0 "$(cat "$BASE/autoplay.pid")" 2>/dev/null; }; then
	setsid python3 -c 'import os, sys; os.closerange(3, 65536); os.execv(sys.executable, [sys.executable] + sys.argv[1:])' \
		"$RT/share/darling-lol/autoplay.py" </dev/null >"$BASE/autoplay.log" 2>&1 &
	echo $! > "$BASE/autoplay.pid"
fi
note "Starting the Riot Client... (the first window can take up to a minute)"
exec sh scripts/run.sh
